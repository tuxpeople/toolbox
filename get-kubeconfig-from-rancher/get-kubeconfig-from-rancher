#!/usr/bin/env bash

# get-kubeconfig-from-rancher - Kubeconfigs aller Rancher-Cluster exportieren
# Iteriert über alle im Rancher-CLI konfigurierten Server, lädt für jeden
# Cluster die Kubeconfig herunter und speichert sie als <server>-<cluster>.yaml

set -euo pipefail

# Globale Variablen
OUTPUT_DIR="${KUBECONFIG_EXPORT_DIR:-${HOME}/iCloudDrive/Allgemein/kubectl}"
SERVER_FILTER=""
ORIGINAL_SERVER=""
TMP_DIR=""
VERBOSE=false
DRY_RUN=false
NO_BACKUP=false

# Statistiken
STATS_TOTAL=0
STATS_SUCCESS=0
STATS_UNCHANGED=0
STATS_ERRORS=0

# Farben für Output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'  # No Color

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1" >&2
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" >&2
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}[VERBOSE]${NC} $1" >&2
    fi
}

show_help() {
    cat << EOF
get-kubeconfig-from-rancher - Kubeconfigs aller Rancher-Cluster exportieren

VERWENDUNG:
    $0 [OPTIONEN]

BESCHREIBUNG:
    Iteriert über alle im Rancher-CLI konfigurierten Server (rancher server ls),
    lädt für jeden Cluster die Kubeconfig herunter und speichert sie als
    <server>-<cluster>.yaml im Ausgabeverzeichnis. Cluster- und Context-Namen
    in der Kubeconfig werden mit dem Server-Namen präfixiert, damit sich die
    Dateien ohne Namenskonflikte zusammenführen lassen.

    Bestehende Dateien werden nur überschrieben, wenn sich der Inhalt geändert
    hat. Vorher wird ein Backup (*.yaml.bak) erstellt.

    Der beim Start aktive Rancher-Server wird am Ende wiederhergestellt.

OPTIONEN:
    -o, --output-dir DIR     Ausgabeverzeichnis
                             (Standard: ${OUTPUT_DIR})
    -s, --server NAME        Nur diesen Rancher-Server verarbeiten
    -B, --no-backup          Kein Backup vor dem Überschreiben erstellen
    -v, --verbose            Detaillierte Ausgabe
    -n, --dry-run            Nur anzeigen was gemacht würde
    -h, --help               Diese Hilfe anzeigen

UMGEBUNGSVARIABLEN:
    KUBECONFIG_EXPORT_DIR    Standard-Ausgabeverzeichnis

BEISPIELE:
    $0                               # Alle Server, Standard-Verzeichnis
    $0 --dry-run                     # Nur anzeigen, welche Dateien entstehen
    $0 -o ~/.kube/rancher            # Eigenes Ausgabeverzeichnis
    $0 -s UMB-rancher-test -v        # Nur einen Server, mit Details

VORAUSSETZUNGEN:
    - rancher (Rancher CLI) muss installiert und per "rancher login"
      für mindestens einen Server konfiguriert sein
    - Netzwerk-Zugriff auf die Rancher-Server

HINWEISE:
    - Kubeconfigs enthalten Zugriffstokens - Dateien werden mit 600 angelegt
    - Ausgabeverzeichnis nur an vertrauenswürdigen Orten verwenden
    - Nicht erreichbare Server werden übersprungen (Exit-Code 2)
EOF
}

check_dependencies() {
    local missing_deps=()

    for dep in rancher sed cmp mktemp; do
        if ! command -v "$dep" &> /dev/null; then
            missing_deps+=("$dep")
        fi
    done

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log_error "Fehlende Abhängigkeiten: ${missing_deps[*]}"
        log_info "Installation:"
        log_info "  macOS: brew install rancher-cli"
        log_info "  Linux: https://github.com/rancher/cli/releases"
        return 1
    fi

    return 0
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -o|--output-dir)
                if [[ -z "${2:-}" ]]; then
                    log_error "Option $1 benötigt ein Verzeichnis"
                    exit 1
                fi
                OUTPUT_DIR="$2"
                shift 2
                ;;
            -s|--server)
                if [[ -z "${2:-}" ]]; then
                    log_error "Option $1 benötigt einen Server-Namen"
                    exit 1
                fi
                SERVER_FILTER="$2"
                shift 2
                ;;
            -B|--no-backup)
                NO_BACKUP=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                log_error "Unbekannte Option: $1"
                show_help
                exit 1
                ;;
        esac
    done
}

validate_parameters() {
    if [[ -e "$OUTPUT_DIR" && ! -d "$OUTPUT_DIR" ]]; then
        log_error "Ausgabepfad ist kein Verzeichnis: $OUTPUT_DIR"
        return 1
    fi

    if [[ ! -d "$OUTPUT_DIR" ]]; then
        if [[ "$DRY_RUN" == "true" ]]; then
            log_info "[DRY-RUN] Würde Verzeichnis erstellen: $OUTPUT_DIR"
        else
            log_info "Erstelle Verzeichnis: $OUTPUT_DIR"
            mkdir -p "$OUTPUT_DIR"
        fi
    fi

    return 0
}

# Aktuell aktiven Rancher-Server ermitteln ("Name: xyz URL: https://...")
get_current_server() {
    rancher server current 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "Name:") print $(i + 1)}'
}

cleanup() {
    if [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]]; then
        rm -rf "$TMP_DIR"
    fi

    if [[ -n "$ORIGINAL_SERVER" ]]; then
        log_verbose "Stelle ursprünglichen Rancher-Server wieder her: $ORIGINAL_SERVER"
        rancher server switch "$ORIGINAL_SERVER" >/dev/null 2>&1 || \
            log_warn "Konnte ursprünglichen Server nicht wiederherstellen: $ORIGINAL_SERVER"
    fi
}

# Sonderzeichen für sed-Regex escapen (z.B. Punkte in Cluster-Namen)
escape_sed() {
    printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g'
}

# Kubeconfig eines Clusters herunterladen und unter neuem Namen speichern
export_cluster() {
    local prefix="$1"
    local cluster="$2"
    local target="${OUTPUT_DIR}/${prefix}-${cluster}.yaml"
    local tmp_file="${TMP_DIR}/${prefix}-${cluster}.yaml"
    local cluster_re
    cluster_re=$(escape_sed "$cluster")

    STATS_TOTAL=$((STATS_TOTAL + 1))

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[DRY-RUN] Würde exportieren: $cluster -> $target"
        return 0
    fi

    log_verbose "Lade Kubeconfig für Cluster: $cluster"
    if ! rancher clusters kubeconfig "$cluster" > "$tmp_file" 2>/dev/null; then
        log_error "Kubeconfig für Cluster '$cluster' konnte nicht geladen werden"
        STATS_ERRORS=$((STATS_ERRORS + 1))
        return 1
    fi

    # Cluster-/Context-Namen präfixieren ("cluster" und ACE-Contexts "cluster-node")
    sed -e "s/\"${cluster_re}\"/\"${prefix}-${cluster}\"/g" \
        -e "s/\"${cluster_re}-/\"${prefix}-${cluster}-/g" \
        "$tmp_file" > "${tmp_file}.renamed"
    chmod 600 "${tmp_file}.renamed"

    if [[ -f "$target" ]]; then
        if cmp -s "${tmp_file}.renamed" "$target"; then
            log_verbose "Unverändert: $target"
            STATS_UNCHANGED=$((STATS_UNCHANGED + 1))
            return 0
        fi

        if [[ "$NO_BACKUP" != "true" ]]; then
            cp -p "$target" "${target}.bak"
            log_verbose "Backup erstellt: ${target}.bak"
        fi
    fi

    mv "${tmp_file}.renamed" "$target"
    log_success "Exportiert: $target"
    STATS_SUCCESS=$((STATS_SUCCESS + 1))
    return 0
}

# Alle Cluster eines Rancher-Servers exportieren
process_server() {
    local server="$1"
    local prefix
    local clusters
    prefix=$(printf '%s' "$server" | tr '[:upper:]' '[:lower:]')

    log_info "Verarbeite Rancher-Server: $server"

    if ! rancher server switch "$server" >/dev/null 2>&1; then
        log_error "Wechsel zu Server '$server' fehlgeschlagen"
        STATS_ERRORS=$((STATS_ERRORS + 1))
        return 1
    fi

    if ! clusters=$(rancher cluster ls --format '{{.Cluster.Name}}' 2>/dev/null); then
        log_error "Cluster-Liste von '$server' konnte nicht abgerufen werden (Server erreichbar?)"
        STATS_ERRORS=$((STATS_ERRORS + 1))
        return 1
    fi

    if [[ -z "$clusters" ]]; then
        log_warn "Keine Cluster auf Server '$server' gefunden"
        return 0
    fi

    while IFS= read -r cluster; do
        [[ -z "$cluster" ]] && continue
        export_cluster "$prefix" "$cluster" || true
    done <<< "$clusters"
}

main() {
    parse_arguments "$@"

    if ! check_dependencies; then
        exit 1
    fi

    if ! validate_parameters; then
        exit 1
    fi

    local servers
    if ! servers=$(rancher server ls --format '{{.Name}}' 2>/dev/null) || [[ -z "$servers" ]]; then
        log_error "Keine Rancher-Server konfiguriert (zuerst 'rancher login' ausführen)"
        exit 1
    fi

    if [[ -n "$SERVER_FILTER" ]]; then
        if ! grep -qxF "$SERVER_FILTER" <<< "$servers"; then
            log_error "Server nicht gefunden: $SERVER_FILTER"
            log_info "Verfügbare Server: $(tr '\n' ' ' <<< "$servers")"
            exit 1
        fi
        servers="$SERVER_FILTER"
    fi

    ORIGINAL_SERVER=$(get_current_server)
    TMP_DIR=$(mktemp -d)
    trap cleanup EXIT
    umask 077

    log_verbose "Ausgabeverzeichnis: $OUTPUT_DIR"
    log_verbose "Ursprünglicher Server: ${ORIGINAL_SERVER:-unbekannt}"

    while IFS= read -r server; do
        [[ -z "$server" ]] && continue
        process_server "$server" || true
    done <<< "$servers"

    log_info "Zusammenfassung: ${STATS_TOTAL} Cluster, ${STATS_SUCCESS} exportiert, ${STATS_UNCHANGED} unverändert, ${STATS_ERRORS} Fehler"

    if [[ $STATS_ERRORS -gt 0 ]]; then
        log_warn "Fertig mit Fehlern"
        exit 2
    fi

    log_success "Fertig!"
}

# Script-Ausführung
main "$@"

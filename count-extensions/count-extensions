#!/usr/bin/env bash

# Script: count-extensions
# Zweck: Zaehlt rekursiv alle Dateiendungen in einem Verzeichnis und zeigt sie
#        absteigend nach Haeufigkeit sortiert an
# Verwendung: ./count-extensions VERZEICHNIS [OPTIONEN]

set -euo pipefail

# Farben für Output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'  # No Color

# Globale Variablen
VERBOSE=false
JSON_OUTPUT=false
TOP_N=0
TARGET_DIR=""

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1" >&2
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" >&2
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}[VERBOSE]${NC} $1" >&2
    fi
}

# Hilfe anzeigen
show_help() {
    cat << EOF
count-extensions - Dateiendungen zaehlen

VERWENDUNG:
    $0 VERZEICHNIS [OPTIONEN]

BESCHREIBUNG:
    Durchsucht ein Verzeichnis rekursiv nach Dateien, ermittelt deren
    Dateiendungen und zeigt eine nach Haeufigkeit absteigend sortierte
    Liste an. Dateien ohne Endung (inkl. versteckte Dateien wie ".bashrc")
    werden dabei ignoriert. Endungen werden ohne Beachtung der
    Gross-/Kleinschreibung gezaehlt (immer klein ausgegeben).

ARGUMENTE:
    VERZEICHNIS               Zu durchsuchendes Verzeichnis

OPTIONEN:
    -t, --top ANZAHL          Nur die ANZAHL haeufigsten Endungen anzeigen
    -j, --json                Ausgabe als JSON statt als Tabelle
    -v, --verbose             Detaillierte Ausgabe
    -h, --help                Diese Hilfe anzeigen

BEISPIELE:
    $0 /pfad/zum/ordner              # Alle Endungen anzeigen
    $0 . --top 10                    # Nur die Top 10 anzeigen
    $0 ./src --json                  # Als JSON ausgeben
    $0 . --json | jq '.[0]'          # Haeufigste Endung weiterverarbeiten

VORAUSSETZUNGEN:
    - find, sort, uniq, tr, awk (POSIX-Standardtools)

HINWEISE:
    - Es werden nur reguläre Dateien gezaehlt, Symlinks werden ignoriert
    - Bei sehr grossen Verzeichnisbaeumen kann der Scan etwas dauern
EOF
}

# Abhängigkeiten prüfen
check_dependencies() {
    local missing_deps=()

    for tool in find sort uniq tr awk; do
        if ! command -v "$tool" &> /dev/null; then
            missing_deps+=("$tool")
        fi
    done

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log_error "Fehlende Abhängigkeiten: ${missing_deps[*]}"
        log_info "Installation:"
        log_info "  macOS: brew install ${missing_deps[*]}"
        log_info "  Linux: apt install ${missing_deps[*]} oder yum install ${missing_deps[*]}"
        return 1
    fi

    return 0
}

# Parameter parsen
parse_arguments() {
    local positional_args=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -t|--top)
                TOP_N="${2:-}"
                shift 2
                ;;
            -j|--json)
                JSON_OUTPUT=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -*)
                log_error "Unbekannte Option: $1"
                show_help
                exit 1
                ;;
            *)
                positional_args+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#positional_args[@]} -lt 1 ]]; then
        log_error "Zu wenige Argumente"
        show_help
        exit 1
    fi

    TARGET_DIR="${positional_args[0]}"
}

# Parameter validieren
validate_parameters() {
    if [[ ! -d "$TARGET_DIR" ]]; then
        log_error "Verzeichnis existiert nicht: $TARGET_DIR"
        return 1
    fi

    if [[ -n "$TOP_N" && "$TOP_N" != "0" ]] && ! [[ "$TOP_N" =~ ^[0-9]+$ ]]; then
        log_error "--top erwartet eine positive Zahl, erhalten: $TOP_N"
        return 1
    fi

    return 0
}

# Dateiendungen im Zielverzeichnis zaehlen (Ausgabe: "  COUNT ext" pro Zeile)
count_extensions() {
    local dir="$1"

    find "$dir" -type f -print0 |
    while IFS= read -r -d '' file; do
        local name="${file##*/}"
        name="${name#.}" # führenden Punkt bei Hidden Files ignorieren

        if [[ "$name" == *.* && "$name" != *. ]]; then
            printf '%s\n' "${name##*.}"
        fi
    done |
    tr '[:upper:]' '[:lower:]' |
    sort |
    uniq -c |
    sort -nr
}

# JSON-String-Escaping (Extension besteht praktisch immer aus [a-z0-9._-],
# trotzdem defensiv escapen)
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

print_table() {
    local results="$1"

    if [[ -z "$results" ]]; then
        log_warn "Keine Dateiendungen gefunden"
        return 0
    fi

    printf '%6s  %s\n' "ANZAHL" "ENDUNG"
    printf '%s\n' "$results" | awk '{printf "%6d  %s\n", $1, $2}'
}

print_json() {
    local results="$1"
    local json="["
    local first=true
    local count ext

    if [[ -n "$results" ]]; then
        while read -r count ext; do
            [[ -z "$ext" ]] && continue
            if [[ "$first" == "true" ]]; then
                first=false
            else
                json+=","
            fi
            json+=$(printf '{"extension":"%s","count":%s}' "$(json_escape "$ext")" "$count")
        done <<< "$results"
    fi

    json+="]"
    printf '%s\n' "$json"
}

# Hauptlogik
main() {
    if ! check_dependencies; then
        exit 1
    fi

    parse_arguments "$@"

    if ! validate_parameters; then
        show_help
        exit 1
    fi

    log_verbose "Verzeichnis: $TARGET_DIR"
    log_verbose "Top-Limit: ${TOP_N:-keins}"
    log_verbose "JSON-Ausgabe: $JSON_OUTPUT"

    log_info "Durchsuche Verzeichnis rekursiv ..."

    local results
    results="$(count_extensions "$TARGET_DIR")"

    if [[ -n "$results" && "$TOP_N" != "0" && -n "$TOP_N" ]]; then
        results="$(printf '%s\n' "$results" | head -n "$TOP_N")"
    fi

    if [[ "$JSON_OUTPUT" == "true" ]]; then
        print_json "$results"
    else
        print_table "$results"
    fi

    log_success "Fertig!"
}

# Script-Ausführung
main "$@"
